# Copy this file to .env and fill in your details.

PORT=3000

# Password for the admin dashboard at /admin (use something long and unique)
ADMIN_PASSWORD=

# Delivery fee (Rs) for orders below the free-delivery threshold set in js/data.js
DELIVERY_FEE=400

# Bank account shown to customers who choose Bank Transfer
BANK_NAME=Your Bank
BANK_ACCOUNT_NAME=Jaydaar
BANK_ACCOUNT_NUMBER=000000000000
BANK_BRANCH=Your Branch

# WhatsApp number customers can contact about orders (international format, no +)
WHATSAPP_NUMBER=94725490944

# Set to true when the site is served over HTTPS (keeps the admin cookie HTTPS-only)
COOKIE_SECURE=false
# Set to true when running behind a reverse proxy / hosting platform
TRUST_PROXY=false
